#!/bin/sh
# pre-commit.hook — 웰페리온 가이드허브 커밋 가드 모음
#                   truncation(대량 라인 유실) 차단 가드 외 (2026-06-13 AI CTO)
# 설치 위치: .git/hooks/pre-commit  (install_hooks.sh 로 설치)
#
# 【실행 순서】
#   ① truncation 가드(scripts/precommit_truncation_guard.py): staged *.html·*.js
#      가 HEAD 대비 30%+ AND 200줄+ 급감하면 커밋 차단(exit 1). 가드 자체 에러나
#      파이썬 없음 = fail-open(통과). 우회: git commit --no-verify
#   ②~ _queue 급감·열린문서 skip·ship_no·_queue 미러·incident·enforcement 가드.
#
# 【안전 원칙】
#   가드 실패 / 변경 없음 → exit 0 (push/commit 절대 막지 않음)

# ── repo root 확인 ────────────────────────────────────────────────────────
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ]; then
  echo "[changelog-hook][WARN] git root 를 찾을 수 없음 — skip"
  exit 0
fi

# ── ① truncation 가드 (대량 라인 유실 차단) ───────────────────────────────
# staged *.html·*.js 가 HEAD 대비 급감하면 커밋 중단(exit 1).
# 가드 스크립트가 없거나 파이썬이 없으면 fail-open(통과).
GUARD="$REPO_ROOT/scripts/precommit_truncation_guard.py"
if [ -f "$GUARD" ]; then
  if command -v python >/dev/null 2>&1; then
    PYBIN=python
  elif command -v python3 >/dev/null 2>&1; then
    PYBIN=python3
  else
    PYBIN=""
  fi
  if [ -n "$PYBIN" ]; then
    # PYTHONUTF8=1 → 한글 경고가 콘솔 코드페이지와 무관하게 출력됨.
    PYTHONUTF8=1 "$PYBIN" "$GUARD"
    GUARD_RC=$?
    if [ "$GUARD_RC" -eq 1 ]; then
      # 차단: 가드가 truncation 을 명시적으로 감지함.
      exit 1
    fi
    # 그 외(0 또는 기타) = 통과(fail-open).
  else
    echo "[truncation-guard][WARN] python 없음 — 가드 skip(통과)"
  fi
fi

# ── ①-2 _queue·review_queue 급감 가드 (스테일 덮어쓰기 차단 · 2026-06-15 AI CTO) ──
# 배열형 status JSON 항목수가 HEAD 대비 급감(8개+ AND 15%+)하면 커밋 차단(exit 1).
# 가드 없음/파이썬 없음/내부오류 = fail-open(통과). 우회: git commit --no-verify
QUEUE_GUARD="$REPO_ROOT/scripts/precommit_queue_guard.py"
if [ -f "$QUEUE_GUARD" ] && [ -n "$PYBIN" ]; then
  PYTHONUTF8=1 "$PYBIN" "$QUEUE_GUARD"
  if [ "$?" -eq 1 ]; then
    exit 1
  fi
fi

# ── ①-2.3 열린(잠긴) 작업문서 건너뛰기 (자동push 잠김사고 근본차단 · 2026-06-22 웰리) ──
# GM이 PowerPoint·PDF 등으로 열어둬 잠긴 작업문서를 이번 커밋 스테이징에서 제외.
# 닫으면 다음 주기에 정상 백업. 충돌·자동push 반복실패 원천차단. 항상 exit 0(fail-open).
SKIP_OPEN_GUARD="$REPO_ROOT/scripts/precommit_skip_open_office.py"
if [ -f "$SKIP_OPEN_GUARD" ] && [ -n "$PYBIN" ]; then
  PYTHONUTF8=1 "$PYBIN" "$SKIP_OPEN_GUARD" || true
fi

# ── ①-2.5 ship_no 자동 부여 (새 배 고정 식별번호 · 2026-06-19) ───────────────
# status/_queue.json 에 ship_no 없는 항목에 clevel별 번호 자동 부여 후 git add.
# assign 실패해도 커밋 차단 안 함(fail-open). 멱등·기존 번호 불변.
SHIP_ASSIGN="$REPO_ROOT/scripts/assign_ship_numbers.py"
if [ -f "$SHIP_ASSIGN" ] && [ -n "$PYBIN" ]; then
  PYTHONUTF8=1 "$PYBIN" "$SHIP_ASSIGN" || true
  git add -- "status/_queue.json" 2>/dev/null || true
fi

# ── ①-3 _queue 발행루트 미러 동기화 (G1 404 방지 · 2026-06-17) ────────────
# 원본 status/_queue.json 이 바뀌면 발행루트 미러
# (3. 웰페리온 가이드/status/_queue.json)로 단방향 복사 후 git add.
# GitHub Pages 발행루트=가이드 폴더라 레포루트 status/ 는 라이브 404 →
# 미러가 라이브 200 도달 실파일. 멱등(동일하면 no-op)·fail-open.
QUEUE_MIRROR="$REPO_ROOT/scripts/sync_queue_mirror.py"
if [ -f "$QUEUE_MIRROR" ] && [ -n "$PYBIN" ]; then
  PYTHONUTF8=1 "$PYBIN" "$QUEUE_MIRROR"
  # 항상 exit 0 (fail-open) — 반환값 무시, 커밋 절대 막지 않음.
fi

# ── ② incident 교훈 가드 (사고 재발 방지 경고 · fail-open) ──────────────────
# 스테이징 파일이 watch_globs 와 매칭되면 해당 사건 요약을 경고 출력.
# gate=warn → 출력만(exit 0). gate=block → exit 1. 가드 오류 → fail-open(통과).
INCIDENT_GUARD="$REPO_ROOT/ssot/precommit_incident_guard.py"
if [ -f "$INCIDENT_GUARD" ]; then
  if [ -n "$PYBIN" ]; then
    PYTHONUTF8=1 "$PYBIN" "$INCIDENT_GUARD"
    INC_RC=$?
    if [ "$INC_RC" -eq 1 ]; then
      exit 1
    fi
    # INC_RC=0 또는 기타 = 통과(fail-open)
  fi
fi

# ── ②-2 화이트리스트 코드강제 가드 (AI 자율화 ③ · 2026-06-24 시토) ──────────
# ssot/enforcement.py 엔진으로 4종(공식값·약속/금지경로/보안 라이브발효) 감지.
# 모드(ssot/enforcement_mode.json): off=무동작 / warn=감지·로그만(비차단) / block=차단.
# 기본=warn. block 은 GM 명시 go 후에만. [GM-approved] 토큰/플래그=우회.
# 가드 오류/엔진없음 = fail-open(통과). warn 은 절대 exit 1 안 함(자동push 보호).
ENFORCE_GUARD="$REPO_ROOT/scripts/precommit_enforcement_guard.py"
if [ -f "$ENFORCE_GUARD" ] && [ -n "$PYBIN" ]; then
  PYTHONUTF8=1 "$PYBIN" "$ENFORCE_GUARD"
  if [ "$?" -eq 1 ]; then
    # block 모드에서만 1 반환 → 차단. warn/off 는 항상 0.
    exit 1
  fi
fi

exit 0
