#!/bin/sh
# pre-commit.hook — 웰페리온 가이드허브 home changelog 자동 갱신
#                   + truncation(대량 라인 유실) 차단 가드 (2026-06-13 AI CTO)
# 설치 위치: .git/hooks/pre-commit  (install_hooks.sh 로 설치)
#
# 【실행 순서】
#   ① truncation 가드(scripts/precommit_truncation_guard.py): staged *.html·*.js
#      가 HEAD 대비 30%+ AND 200줄+ 급감하면 커밋 차단(exit 1). 가드 자체 에러나
#      파이썬 없음 = fail-open(통과). 우회: git commit --no-verify
#   ② home changelog 자동 갱신(기존 로직).
#
# 【방식: pre-commit 선택 이유】
#   pre-push 에서 git commit 을 하면 해당 커밋은 이미 결정된 push 범위 밖이라
#   "다음 push" 에만 포함됨 → 목표(현재 push에 포함) 달성 불가.
#   pre-commit 은 커밋 생성 직전에 실행되므로 git add 만 하면
#   changelog 갱신분이 해당 커밋에 자동 포함됨. push 재귀도 없음.
#
# 【무한루프 방지】
#   커밋 메시지 첫 줄이 "auto(changelog):" 로 시작하면 skip.
#   또한 auto changelog 커밋 자체는 --no-verify 로 생성하므로
#   이 hook 이 재실행되지 않음.
#
# 【안전 원칙】
#   스크립트 실패 / 변경 없음 → exit 0 (push/commit 절대 막지 않음)

# ── 직전 커밋 메시지 확인 (무한루프 가드 1: 현재 커밋 메시지) ────────────
# COMMIT_EDITMSG 는 현재 커밋 준비 중인 메시지 파일
COMMIT_MSG_FILE=".git/COMMIT_EDITMSG"
if [ -f "$COMMIT_MSG_FILE" ]; then
  FIRST_LINE="$(head -n 1 "$COMMIT_MSG_FILE" 2>/dev/null)"
  case "$FIRST_LINE" in
    auto\(changelog\):*)
      echo "[changelog-hook] auto(changelog) 커밋 — skip"
      exit 0
      ;;
  esac
fi

# ── repo root 확인 ────────────────────────────────────────────────────────
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ]; then
  echo "[changelog-hook][WARN] git root 를 찾을 수 없음 — skip"
  exit 0
fi

# ── ① truncation 가드 (대량 라인 유실 차단) ───────────────────────────────
# staged *.html·*.js 가 HEAD 대비 급감하면 커밋 중단(exit 1).
# 가드 스크립트가 없거나 파이썬이 없으면 fail-open(통과).
GUARD="$REPO_ROOT/scripts/precommit_truncation_guard.py"
if [ -f "$GUARD" ]; then
  if command -v python >/dev/null 2>&1; then
    PYBIN=python
  elif command -v python3 >/dev/null 2>&1; then
    PYBIN=python3
  else
    PYBIN=""
  fi
  if [ -n "$PYBIN" ]; then
    # PYTHONUTF8=1 → 한글 경고가 콘솔 코드페이지와 무관하게 출력됨.
    PYTHONUTF8=1 "$PYBIN" "$GUARD"
    GUARD_RC=$?
    if [ "$GUARD_RC" -eq 1 ]; then
      # 차단: 가드가 truncation 을 명시적으로 감지함.
      exit 1
    fi
    # 그 외(0 또는 기타) = 통과(fail-open).
  else
    echo "[truncation-guard][WARN] python 없음 — 가드 skip(통과)"
  fi
fi

SCRIPT="$REPO_ROOT/scripts/update_guide_hub_changelog.py"
GUIDE_HTML="$REPO_ROOT/3. 웰페리온 가이드/wellperion_guide(main).html"

# ── 스크립트 존재 확인 ────────────────────────────────────────────────────
if [ ! -f "$SCRIPT" ]; then
  echo "[changelog-hook][WARN] 스크립트 없음: $SCRIPT — skip"
  exit 0
fi

# ── changelog 갱신 실행 ───────────────────────────────────────────────────
echo "[changelog-hook] home changelog 갱신 중..."
python "$SCRIPT"
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
  echo "[changelog-hook][WARN] 스크립트 실패 (exit $EXIT_CODE) — push 는 계속 진행"
  exit 0
fi

# ── 변경 여부 확인 후 stage ────────────────────────────────────────────────
# git diff --name-only: 워킹트리 변경 (unstaged)
CHANGED="$(git diff --name-only -- "3. 웰페리온 가이드/wellperion_guide(main).html" 2>/dev/null)"
if [ -n "$CHANGED" ]; then
  echo "[changelog-hook] 변경 감지 → git add"
  git add -- "3. 웰페리온 가이드/wellperion_guide(main).html"
  echo "[changelog-hook] staged: wellperion_guide(main).html (이번 커밋에 포함됨)"
else
  echo "[changelog-hook] 변경 없음 — no-op"
fi

exit 0
