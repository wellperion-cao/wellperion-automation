#!/bin/sh
# pre-push.hook — 🔒 자물쇠 라인(배1098 · GM 지시 2026-09-07) 맨손 push 차단
# 설치: scripts/install_hooks.sh (→ .git/hooks/pre-push)
#
# scripts/safe_commit.py 를 거치지 않은 맨손 `git push` 가 잠금 경로(status/push_lock.json)를
# 실은 채 master 로 가는 것만 막는다. 판정은 scripts/push_lock.py 단일 출처(약속 L21 —
# safe_commit 의 자물쇠 분기와 같은 함수를 쓴다). lock/<id> 브랜치 자체의 push(승인 흐름의
# 일부 — 스위퍼가 만든다)는 대상 밖이라 통과한다.
#
# 【안전 원칙】 가드 실패/파이썬 없음 = fail-open(push 통과) — 가드 버그로 정상 push 가
# 막히면 안 된다. 우회: git push --no-verify(사람이 판단해서만).
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ]; then
  exit 0
fi
if command -v python >/dev/null 2>&1; then
  PYBIN=python
elif command -v python3 >/dev/null 2>&1; then
  PYBIN=python3
else
  exit 0
fi
GUARD="$REPO_ROOT/scripts/push_lock.py"
if [ ! -f "$GUARD" ]; then
  exit 0
fi
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue
  PYTHONUTF8=1 "$PYBIN" "$GUARD" --check-push "$remote_ref" "$remote_sha" "$local_sha"
  if [ "$?" -eq 1 ]; then
    exit 1
  fi
done
exit 0
