[Unit]
Description=Wellperion ERP auth gateway (FastAPI)
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/srv/erp/auth
EnvironmentFile=/srv/erp/auth.env
ExecStart=/usr/bin/python3 -m uvicorn app:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
