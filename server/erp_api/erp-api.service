[Unit]
Description=Wellperion inquiry mirror API (FastAPI)
After=network.target postgresql.service

[Service]
User=ec2-user
WorkingDirectory=/srv/erp/api
EnvironmentFile=/srv/erp/api.env
EnvironmentFile=/srv/erp/db.env
ExecStart=/usr/bin/python3 -m uvicorn app:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
